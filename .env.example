# OPENAI_API_KEY: Required for OpenAI API calls (server / serverless deploys).
# Set this in your host's env/secret settings (Vercel, Netlify) or a local .env file.
# Never expose it to the browser in a public deployment.
OPENAI_API_KEY="sk-MY_OPENAI_API_KEY"

# OPENAI_BASE_URL: Optional. Override the API endpoint if you use an
# OpenAI-compatible provider (e.g. https://openrouter.ai/api/v1). Defaults to
# https://api.openai.com/v1.
# OPENAI_BASE_URL="https://api.openai.com/v1"

# VITE_OPENAI_API_KEY: Optional build-time key baked into the frontend bundle.
# ONLY safe for personal/private deployments — anyone viewing the site source
# can extract it. For public web-only deploys, leave this unset and let users
# paste their own key in the in-app "API Key" dialog instead.
# VITE_OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
