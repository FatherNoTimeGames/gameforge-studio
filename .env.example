# Server-only secret. API billing is separate from your ChatGPT subscription.
OPENAI_API_KEY=
# Production requires a password of at least 16 characters. Use HTTPS hosting.
APP_USERNAME=owner
APP_PASSWORD=
# Set to a directory on a persistent disk for access across devices.
# For local development, ./data works. Render uses /var/data/gameforge.
DATA_DIR=./data
# Your deployed HTTPS origin. Leave empty when running locally.
APP_URL=
PORT=3000
